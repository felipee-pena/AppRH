  <diagram id="p3n" name="3. Frontend em camadas">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="940" math="0" shadow="0" background="#070b16">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="&lt;b&gt;Frontend — SPA component-based em camadas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;align=left;verticalAlign=middle;fontColor=#67e8f9;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="32" as="geometry"/></mxCell>
        <mxCell id="p3-subtitle" value="Não é MVC clássico: Pages compõem, Components desenham, Hooks guardam estado, Services falam HTTP" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=middle;fontColor=#7dd3fc;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1000" height="22" as="geometry"/></mxCell>
