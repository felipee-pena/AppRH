        <mxCell id="p2-req" value='&lt;b&gt;Requisição HTTP da SPA&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;JSON + Authorization: Bearer&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#151a26;strokeColor=#94a3b8;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="p2-sec" value='&lt;b&gt;Spring Security&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;SecurityFilterChain · CORS&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;Filtro JWT: assinatura, exp, perfil&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;401 sem token · 403 sem permissão&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f151f;strokeColor=#f87171;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="184" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-ctl" value='&lt;b&gt;Controller — @RestController&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;recebe HTTP e converte JSON em DTO&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;Bean Validation&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;chama o Service e devolve o status&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#0c1f23;strokeColor=#34d399;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="308" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-svc" value='&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;casos de uso e regras de negócio&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;@Transactional&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;verifica ownership (RH dono da vaga)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;aciona o envio de e-mail&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#0c1f23;strokeColor=#34d399;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="432" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p2-rep" value='&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;interfaces Spring Data JPA&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;consultas, grava e devolve entidades&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#0c1f23;strokeColor=#34d399;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="572" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-db" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;Supabase · JDBC/TLS&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#0c2326;strokeColor=#34d399;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2-dto" value='&lt;b&gt;DTOs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;request e response&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;Entity nunca sai da API&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;documentados via OpenAPI&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#0c1d2d;strokeColor=#38bdf8;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="308" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-mail" value='&lt;b&gt;Serviço de e-mail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;confirmação de cadastro&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;recuperação de senha&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;via SMTP&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f1e16;strokeColor=#facc15;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-fly" value='&lt;b&gt;Flyway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;migrations SQL versionadas&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f181a;strokeColor=#fb923c;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="p2-anti" value='&lt;b&gt;✗ Controller → Repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;não é usado: levaria regra de&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;negócio e transação para o&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;controller&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f151f;strokeColor=#f87171;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="60" y="572" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-oauth" value='&lt;b&gt;Google — OAuth 2.0 + OIDC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;ID token validado no backend,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;que emite o JWT da aplicação&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f181a;strokeColor=#fb923c;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="184" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-err" value='&lt;b&gt;Tratamento de erros&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;@RestControllerAdvice&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;status, message, path,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;timestamp, errors&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#1f1e16;strokeColor=#facc15;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="308" width="260" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-ent" value='&lt;b&gt;Entity / Domain Model&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;User · Company · Job&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;tokens de confirmação e de senha&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;relacionamentos e invariantes&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;O Service manipula; o Repository&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;persiste e devolve. Não é uma&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#a9b8cc"&gt;camada abaixo do Repository.&lt;/font&gt;' style="rounded=1;arcSize=10;fillColor=#17182d;strokeColor=#a78bfa;align=center;verticalAlign=middle;spacingLeft=56;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#f1f5f9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="260" height="180" as="geometry"/></mxCell>
